# Copy to server/.env and fill in. server/.env is gitignored -- never commit it.

# The Postgres superuser's password. Used only by the scripts, to create the
# per-service databases and to run verify.sh.
DB_PASSWORD=your_postgres_password

# Password for the four per-service roles (catalog_svc, inventory_svc,
# checkout_svc, analytics_svc) that create-db.sh creates. The services log in
# with these; none of them uses the superuser.
SERVICE_DB_PASSWORD=choose_a_password

# Optional overrides (defaults shown)
#DB_HOST=localhost
#DB_PORT=5432
#DB_USER=postgres
