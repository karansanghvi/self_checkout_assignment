<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>com.school</groupId>
  <artifactId>self-checkout-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>self-checkout</name>
  <description>Microservices implementation of the self-checkout API contract</description>

  <!--
    Module graph:

      services/*  ──►  common          (wire contract, errors, HTTP helpers)
      services/*  ──►  their OWN database, never another service's

    No service module depends on another service module or on any shared
    data library (there are none). Services reach each other only over HTTP
    (the stock-commit saga, the catalog replica, the reset fan-out) or through
    Kafka (the scan feed).
  -->
  <modules>
    <module>common</module>

    <module>services/catalog-service</module>
    <module>services/inventory-service</module>
    <module>services/checkout-service</module>
    <module>services/analytics-service</module>
    <module>services/admin-service</module>

    <module>gateway</module>

    <module>architecture-tests</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <spring-cloud.version>2025.0.0</spring-cloud.version>
    <archunit.version>1.4.1</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.school</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- The `exec`-classified fat jars are the deployables; these plain jars are for architecture-tests. -->
      <dependency>
        <groupId>com.school</groupId>
        <artifactId>catalog-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.school</groupId>
        <artifactId>checkout-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.school</groupId>
        <artifactId>inventory-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.school</groupId>
        <artifactId>analytics-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.school</groupId>
        <artifactId>admin-service</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        Plain `archunit`, not `archunit-junit5`: with the latter, both the
        ArchUnit engine and JUnit Jupiter discover an @AnalyzeClasses class,
        and Jupiter wins under Surefire, so the rules silently report
        "Tests run: 0" and enforce nothing.
      -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          Each deployable is repackaged as a separate `-exec` fat jar, leaving
          the module's ordinary jar in place. That is what lets
          architecture-tests put every service on one classpath and check the
          rules across them.
        -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <executions>
            <execution>
              <id>repackage</id>
              <goals>
                <goal>repackage</goal>
              </goals>
              <configuration>
                <classifier>exec</classifier>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
